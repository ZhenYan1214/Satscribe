# Satscribe Frontend Environment Configuration
# 複製此檔案為 .env 並填入實際值

# 應用程式設定
VITE_APP_TITLE=Satscribe
VITE_APP_DESCRIPTION=去中心化創作者支持與訂閱平台

# Stacks 區塊鏈設定
# 選項: 'testnet' | 'mainnet'
VITE_STACKS_NETWORK=testnet
VITE_STACKS_API_URL=https://api.testnet.hiro.so

# 智慧合約地址 (部署後填入)
VITE_SUBSCRIPTION_NFT_CONTRACT=YOUR_CONTRACT_ADDRESS
VITE_REVENUE_SPLITTER_CONTRACT=YOUR_CONTRACT_ADDRESS
VITE_CREATOR_REGISTRY_CONTRACT=YOUR_CONTRACT_ADDRESS

# 錢包設定
VITE_WALLET_NETWORK=testnet

# API 設定
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=10000

# Lightning Network 設定 (Phase 2)
VITE_LIGHTNING_ENABLED=false
VITE_LIGHTNING_API_URL=YOUR_LIGHTNING_API_URL

# 開發模式設定
VITE_DEBUG_MODE=true
VITE_SHOW_CONSOLE_LOGS=true

# 功能開關
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

# 檔案上傳設定 (bytes)
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4

# 社交媒體連結
VITE_TWITTER_URL=https://twitter.com/satscribe
VITE_DISCORD_URL=https://discord.gg/satscribe
VITE_GITHUB_URL=https://github.com/satscribe